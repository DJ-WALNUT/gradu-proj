# 이 기기에만 해당하는 값. 복사해서 .env 로 쓴다. 나머지 설정은 모두 서버 번들에서 온다.

# 서버 주소 (끝 / 없이). QR 도 이 주소로 만든다. 제출본은 서버 없이 실행하므로 비워 둔다
SERVER_URL=
# 카메라 번호 (0 부터)
CAMERA_INDEX=0
# 카메라 해상도
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
# 리모컨 포트: 비우면 자동 탐색, off 면 끔, COM3 처럼 직접 지정도 가능
REMOTE_PORT=
# 영수증 프린터 포트 (CPP-3000): 비우면 USB 번호로 자동 탐색, off 면 끔, COM5 처럼 직접 지정, dummy 는 파일로만 저장(개발용)
PRINTER_PORT=
# 전체 화면 (true/false)
BOOTH_FULLSCREEN=true
# 동기화 주기(초). 있으면 번들 값보다 우선. 비우면 번들 값 사용
SYNC_INTERVAL=
# 버스트샷 (기본 켜짐). 0 이면 끔
BOOTH_BURST=1
# 현장 기록 (숫자만, 사진 없음). 1 이면 data/logs/capture_metrics.jsonl 에 남김
BOOTH_CAPTURE_LOG=0
# 스마트 구도 보정 (기본 켜짐). 0 이면 끔
BOOTH_SMART_CROP=1